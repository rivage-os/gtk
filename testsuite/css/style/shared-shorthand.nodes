window.background:dir(ltr)
  --first: 2px; /* shared-shorthand.css:2:12-15 */
  --second: 7px; /* shared-shorthand.css:3:13-16 */

  box.horizontal:dir(ltr)
    --first: 2px; /* shared-shorthand.css:2:12-15 */
    --second: 7px; /* shared-shorthand.css:3:13-16 */

    label.first:dir(ltr)
      margin-top: 2px; /* shared-shorthand.css:8:3-24 */
      margin-left: 9px; /* shared-shorthand.css:9:3-20 */
      margin-bottom: 2px; /* shared-shorthand.css:8:3-24 */
      margin-right: 2px; /* shared-shorthand.css:8:3-24 */
      padding-top: 3px; /* shared-shorthand.css:10:3-30 */
      padding-left: 3px; /* shared-shorthand.css:10:3-30 */
      padding-bottom: 3px; /* shared-shorthand.css:10:3-30 */
      padding-right: 3px; /* shared-shorthand.css:10:3-30 */
      --first: 2px; /* shared-shorthand.css:2:12-15 */
      --second: 7px; /* shared-shorthand.css:3:13-16 */
    label.second:dir(ltr)
      margin-top: 7px; /* shared-shorthand.css:14:3-25 */
      margin-left: 7px; /* shared-shorthand.css:14:3-25 */
      margin-bottom: 7px; /* shared-shorthand.css:14:3-25 */
      margin-right: 7px; /* shared-shorthand.css:14:3-25 */
      padding-top: 5px; /* shared-shorthand.css:15:3-30 */
      padding-left: 5px; /* shared-shorthand.css:15:3-30 */
      padding-bottom: 5px; /* shared-shorthand.css:15:3-30 */
      padding-right: 5px; /* shared-shorthand.css:15:3-30 */
      --first: 2px; /* shared-shorthand.css:2:12-15 */
      --second: 7px; /* shared-shorthand.css:3:13-16 */
